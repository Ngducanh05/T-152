# Copy this file to .env and provide local values.
# Never commit .env or real credentials.

# ---- Application ----
APP_NAME=ParkSmart AI
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=false
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://parksmart:parksmart@localhost:5432/parksmart

# ---- MVP behavior ----
RESERVATION_TTL_SECONDS=300
SIMULATOR_ENABLED=true
DEMO_MODE=true

# ---- Authentication ----
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_REPORT_EVIDENCE_BUCKET=wrong-parking-evidence
REPORT_EVIDENCE_MAX_BYTES=5000000

# ---- LLM ----
LLM_API_KEY=
LLM_MODEL=openrouter/free
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
OPENAI_API_BASE=https://openrouter.ai/api/v1

# ---- Speech ----
SPEECH_ENABLED=false
SPEECH_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
SPEECH_MAX_AUDIO_BYTES=2000000
SPEECH_TIMEOUT_SECONDS=60
SPEECH_MAX_RETRIES=1

# ---- Agent ----
AGENT_ENABLED=true
AGENT_DAILY_REQUEST_LIMIT=0
AGENT_MAX_STEPS=8
AGENT_THREAD_TTL_SECONDS=3600

# ---- Logging ----
LOG_LEVEL=INFO

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=P152-production
LANGCHAIN_TRACING_V2=false

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=
AI_LOG_DIR=.ai-log

# ---- Grafana / OpenTelemetry ----
OTEL_SERVICE_NAME=parksmart-backend
OTEL_SERVICE_VERSION=0.1.0
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-ap-southeast-1.grafana.net/otlp
# Expected shape: Authorization=Basic%20<base64-credential>
OTEL_EXPORTER_OTLP_HEADERS=

OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=none

OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_METRIC_EXPORT_INTERVAL=60000

OBSERVABILITY_ENABLED=false
LOG_FORMAT=text

# ---- Reservation / background worker ----
RESERVATION_EXPIRY_INTERVAL_SECONDS=30
RESERVATION_EXPIRY_BATCH_SIZE=100
IDEMPOTENCY_TTL_SECONDS=86400

# ---- Verified community contributions ----
REWARDS_REDEMPTION_ENABLED=false
ADJACENT_OBSERVATION_REWARD_POINTS=10
WRONG_PARKING_REPORT_REWARD_POINTS=20
CONTRIBUTION_DAILY_POINTS_LIMIT=100
REWARD_BUSINESS_TIMEZONE=Asia/Ho_Chi_Minh
OBSERVATION_VERIFICATION_TTL_SECONDS=1800
REPORT_REWARD_COOLDOWN_SECONDS=3600

# ---- Authentication runtime controls ----
WRONG_PARKING_REPORT_DAILY_LIMIT=5
AUTH_VERIFICATION_CACHE_TTL_SECONDS=15
AUTH_VERIFICATION_CACHE_MAX_ENTRIES=2048

# ---- Deployment metadata ----
SERVICE_VERSION=0.1.0
GIT_COMMIT_SHA=
