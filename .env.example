# Copy this file to .env and provide local values.
# Never commit .env or real credentials.

# ---- Application ----
APP_NAME=ParkSmart AI
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=false
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://parksmart:parksmart@localhost:5432/parksmart

# ---- MVP behavior ----
RESERVATION_TTL_SECONDS=300
SIMULATOR_ENABLED=true
DEMO_MODE=true

# ---- Authentication ----
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- LLM ----
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0

# ---- Logging ----
LOG_LEVEL=INFO

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=false

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=
AI_LOG_DIR=.ai-log
